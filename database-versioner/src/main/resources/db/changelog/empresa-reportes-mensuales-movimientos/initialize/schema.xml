<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd">

    <changeSet id="2024-05-07-crear-tabla-empresas-reportes-mensuales-movimientos" author="carlos.garnica@pelisat.com.mx">
        <!-- This part will hold the catalogos tables -->
        <createTable tableName="empresas_reportes_mensuales_movimientos">
            <column name="ID" type="int"></column>
            <column name="UUID" type="varchar(12)"></column>
            <column name="REPORTE_MENSUAL" type="int"></column>
            <column name="TIPO" type="varchar(15)"></column>
            <column name="MOVIMIENTO" type="varchar(10)"></column>
            <column name="ELEMENTOS" type="blob"></column>
            <column name="ELIMINADO" type="bit" defaultValue="0"></column>
            <column name="FECHA_CREACION" type="datetime" defaultValueComputed="NOW()"></column>
            <column name="CREADO_POR" type="int"></column>
            <column name="FECHA_ACTUALIZACION" type="datetime" defaultValueComputed="NOW()"></column>
            <column name="ACTUALIZADO_POR" type="int"></column>
        </createTable>

        <!-- Adding the primary key and the autoincrement -->
        <addPrimaryKey tableName="empresas_reportes_mensuales_movimientos" columnNames="ID" />
        <addAutoIncrement tableName="empresas_reportes_mensuales_movimientos" columnName="ID" columnDataType="int" startWith="1" incrementBy="1"/>

        <!-- Setting the unique constraints -->
        <addUniqueConstraint tableName="empresas_reportes_mensuales_movimientos" columnNames="UUID" />
    </changeSet>
</databaseChangeLog>